{
  "name": "hyprland-mcp",
  "version": "0.1.0",
  "description": "MCP server for controlling Hyprland via hyprctl",
  "type": "module",
  "bin": {
    "hyprland-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "test": "tsc && node --test build/__tests__/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
